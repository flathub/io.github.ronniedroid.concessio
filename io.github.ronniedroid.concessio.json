{
    "app-id": "io.github.ronniedroid.concessio",
    "runtime": "org.gnome.Platform",
    "runtime-version": "49",
    "sdk": "org.gnome.Sdk",
    "command": "concessio",
    "finish-args": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--share=ipc",
        "--device=dri"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/doc",
        "/share/man",
        "*.a",
        "*.la"
    ],
    "modules": [
        {
            "name": "concessio",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/ronniedroid/concessio.git",
                    "tag": "v1.0.0",
                    "commit": "e3e686294a6ed9ece7d53357de1f16b73cdf289b"
                }
            ]
        }
    ]
}
